{{ 'journey.css' | asset_url | stylesheet_tag }}<script src="{{ 'journey.js' | asset_url }}" defer></script>
<t4t-journey class="section dog-journey" id="experience"><div class="journey-heading"><div><p class="eyebrow">FIVE PHASES. ONE VERY GOOD DOG.</p><h2>{{ section.settings.heading | escape | newline_to_br }}</h2></div><p>{{ section.settings.intro | escape }}<small>Every dog progresses differently. These are milestones, not a race or a fixed session timeline.</small></p></div>
