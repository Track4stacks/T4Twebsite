<section class="section pricing t4t-memberships" id="memberships"><div class="pricing-top"><div><p class="eyebrow dark">MAKE GOOD DAYS A HABIT</p><h2>{{ section.settings.heading | escape }}</h2></div><div class="rte">{{ section.settings.description }}</div></div><div class="price-grid">{% for block in section.blocks %}{% assign membership = block.settings.product %}<article class="price-card{% if block.settings.featured %} featured{% endif %}" {{ block.shopify_attributes }}><div class="card-top">{{ block.settings.frequency | escape }}</div><h3>{{ block.settings.title | escape }}</h3><div class="rte">{{ block.settings.description }}</div>{% if membership != blank and membership.selling_plan_groups.size > 0 %}<p class="price-note">Choose your dog count and renewal schedule to see the recurring price.</p><a class="button" href="{{ membership.url }}">Choose {{ block.settings.title | escape }}</a>{% else %}<p class="price-note">Contact us for current membership options.</p><a class="button" href="mailto:{{ settings.contact_email | escape }}">Ask about {{ block.settings.title | escape }}</a>{% if request.design_mode %}<p class="section-editor-note">Select a Shopify product with active selling plans for this membership.</p>{% endif %}{% endif %}</article>{% endfor %}</div><p class="price-note">{{ section.settings.billing_note | escape }}</p></section>
{% schema %}
{
  "name": "Recurring memberships",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find their favorite routine."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Choose the pace that fits your pack. Recurring memberships renew through Shopify checkout.</p>"
    },
    {
      "type": "textarea",
      "id": "billing_note",
      "label": "Billing disclosure",
      "default": "Your product page and checkout show the exact recurring price and billing schedule. Membership payments do not automatically reserve appointment times."
    }
  ],
  "blocks": [
    {
      "type": "membership",
      "name": "Membership",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Subscription product"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "default": "Stride"
        },
        {
          "type": "text",
          "id": "frequency",
          "label": "Frequency",
          "default": "ONCE A WEEK"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>A consistent routine for your dog.</p>"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Highlight this plan",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recurring memberships",
      "blocks": [
        {
          "type": "membership",
          "settings": {
            "title": "Trot",
            "frequency": "EVERY OTHER WEEK",
            "description": "<p>A gentle start to a regular routine.</p>"
          }
        },
        {
          "type": "membership",
          "settings": {
            "title": "Stride",
            "frequency": "ONCE A WEEK",
            "featured": true,
            "description": "<p>A weekly visit to keep the good energy going.</p>"
          }
        },
        {
          "type": "membership",
          "settings": {
            "title": "Sprint",
            "frequency": "2\u20134 VISITS A WEEK",
            "description": "<p>Two weekly visits for your high-energy crew.</p>"
          }
        }
      ]
    }
  ],
  "limit": 1
}
{% endschema %}
