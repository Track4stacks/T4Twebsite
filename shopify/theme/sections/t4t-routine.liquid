<section class="routine section"><div class="routine-image">{% render 't4t-image', image: section.settings.image_1, fallback: 'dog-session.jpg', width: 1600, height: 1200, loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', alt: 'Inside the Tracks 4 Treats van with dog-powered treadmills and harnesses', image_class: '' %}<div class="image-label">THE GYM THAT COMES TO YOU.</div></div><div class="routine-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape | newline_to_br }}</h2><ol class="steps"><li><span>01</span><div><h3>Pick your run.</h3><p>Check your service area, then choose a session and an available time in our online calendar.</p></div></li><li><span>02</span><div><h3>We roll up.</h3><p>Your coach meets you at home and helps your dog get comfortable in the gym.</p></div></li><li><span>03</span><div><h3>Let the good times run.</h3><p>A 20–30 minute workout, at their pace. Then it’s back to you for the best part: post-run cuddles.</p></div></li></ol><a class="button" href="{% if settings.booking_page != blank %}{{ settings.booking_page.url }}{% else %}{{ routes.root_url }}pages/booking{% endif %}">Find a time for your pup</a></div></section>
{% schema %}
{
  "name": "How it works",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Photo"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "A new routine.\nIn three steps."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "LESS LOGISTICS. MORE TAIL WAGS."
    }
  ],
  "presets": [
    {
      "name": "Routine"
    }
  ],
  "limit": 1
}
{% endschema %}
