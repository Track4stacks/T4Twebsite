{%- liquid
assign current_variant = product.selected_or_first_available_variant
assign subscription_only = product.requires_selling_plan
if template.suffix == 'membership'
  assign subscription_only = true
endif
assign selected_allocation = current_variant.selected_selling_plan_allocation
if subscription_only and selected_allocation == blank
  assign selected_allocation = current_variant.selling_plan_allocations.first
endif
assign product_form_id = 'ProductForm-' | append: section.id
-%}
<section class="t4t-page t4t-product" data-product-section data-subscription-only="{{ subscription_only }}">
<div>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1400 | image_tag: widths: '400, 700, 1000, 1400', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'eager' }}{% else %}<img src="{{ 'running-dog.jpg' | asset_url }}" alt="A dog enjoying a Tracks 4 Treats run" width="1290" height="2294" loading="eager">{% endif %}</div>
<div><p class="eyebrow">GOOD DAYS, ON REPEAT</p><h1>{{ product.title | escape }}</h1><div class="rte">{{ product.description }}</div>
<p class="product-price" data-product-price aria-live="polite">{% if selected_allocation %}{{ selected_allocation.price | money_with_currency }}{% else %}{{ current_variant.price | money_with_currency }}{% endif %}</p>
{% form 'product', product, id: product_form_id %}
{{ form.errors | default_errors }}
<div class="native-option-selects" data-option-selects hidden>{% for option in product.options_with_values %}<label for="Option-{{ section.id }}-{{ forloop.index }}">{{ option.name | escape }}</label><select id="Option-{{ section.id }}-{{ forloop.index }}" data-option-index="{{ forloop.index0 }}">{% for value in option.values %}<option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value | escape }}</option>{% endfor %}</select>{% endfor %}</div><div data-variant-fallback><label for="Variant-{{ section.id }}">{{ 'products.choose_variant' | t }}</label>
<select id="Variant-{{ section.id }}" name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant.id == current_variant.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} — {{ 'products.sold_out' | t }}{% endunless %}</option>{% endfor %}</select></div>
<div data-plan-field{% if current_variant.selling_plan_allocations.size == 0 %} hidden{% endif %}><label for="Plan-{{ section.id }}">Renewal schedule</label><select id="Plan-{{ section.id }}" name="selling_plan" data-plan-select{% if subscription_only %} required{% endif %}>{% unless subscription_only %}<option value="">One-time purchase</option>{% endunless %}{% for allocation in current_variant.selling_plan_allocations %}<option value="{{ allocation.selling_plan.id }}"{% if selected_allocation.selling_plan.id == allocation.selling_plan.id %} selected{% endif %}>{{ allocation.selling_plan.name | escape }} — {{ allocation.price | money_with_currency }}</option>{% endfor %}</select></div>
<div class="plan-note" data-plan-note{% unless selected_allocation %} hidden{% endunless %}>{{ selected_allocation.selling_plan.name | escape }}{% if selected_allocation.selling_plan.description != blank %}<br>{{ selected_allocation.selling_plan.description | strip_html | escape }}{% endif %}</div>
{% if subscription_only %}<p>Visit frequency is the number of dog-gym visits. Renewal schedule is how often your membership is billed. Your exact recurring terms are shown at checkout.</p><p>Buying a membership does not reserve appointment times. Arrange your visits separately.</p>{% endif %}
<label for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label><input id="Quantity-{{ section.id }}" name="quantity" type="number" min="1" value="1" inputmode="numeric">
<p data-product-error role="status" class="product-form-error">{% if subscription_only and current_variant.selling_plan_allocations.size == 0 %}This membership is not available for online purchase yet. Please contact us.{% endif %}</p>
<button class="button" type="submit" name="add" data-add-button{% unless current_variant.available %} disabled{% endunless %}{% if subscription_only and current_variant.selling_plan_allocations.size == 0 %} disabled{% endif %}>{% if current_variant.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</button>
{% endform %}
{% for block in section.blocks %}<div {{ block.shopify_attributes }}>{% render block %}</div>{% endfor %}
</div>
<script type="application/json" data-variant-data>[
{% for variant in product.variants %}{"id":{{ variant.id | json }},"available":{{ variant.available | json }},"options":{{ variant.options | json }},"price":{{ variant.price | money_with_currency | json }},"plans":[{% for allocation in variant.selling_plan_allocations %}{"id":{{ allocation.selling_plan.id | json }},"name":{{ allocation.selling_plan.name | json }},"description":{{ allocation.selling_plan.description | strip_html | json }},"price":{{ allocation.price | money_with_currency | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}{% unless forloop.last %},{% endunless %}{% endfor %}
]</script>
</section><script src="{{ 'selling-plans.js' | asset_url }}" defer></script>
<script type="application/ld+json">{{ product | structured_data }}</script>

{% schema %}
{
  "name": "Product",
  "settings": [],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
