<section class="t4t-page"><h1>{{ 'cart.title' | t }}</h1>{% if cart.empty? %}<p>{{ 'cart.empty' | t }}</p><a class="button" href="{{ routes.root_url }}#memberships">Explore memberships</a>{% else %}<form action="{{ routes.cart_url }}" method="post" id="CartForm">{% for item in cart.items %}<div class="t4t-cart-row"><div><a href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a>{% unless item.product.has_only_default_variant %}<small>{{ item.variant.title | escape }}</small>{% endunless %}{% if item.selling_plan_allocation %}<small class="subscription-line">{{ item.selling_plan_allocation.selling_plan.name | escape }}</small>{% endif %}{% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% if property.last != blank and first_character != '_' %}<small>{{ property.first | escape }}: {{ property.last | escape }}</small>{% endif %}{% endfor %}<a href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></div><label for="Quantity-{{ item.index | plus: 1 }}">Quantity<input id="Quantity-{{ item.index | plus: 1 }}" name="updates[]" value="{{ item.quantity }}" type="number" min="0" inputmode="numeric" aria-label="Quantity for {{ item.product.title | escape }}"></label><strong>{{ item.final_line_price | money_with_currency }}</strong></div>{% endfor %}<p class="t4t-cart-total">Subtotal {{ cart.total_price | money_with_currency }}</p>{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }}: −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<p>Taxes and any shipping are calculated at checkout. Recurring terms are shown for subscription items.</p><div class="t4t-cart-checkout"><button class="button outline-button" type="submit" name="update">{{ 'cart.update' | t }}</button><button class="button" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button></div></form>{% endif %}</section>
{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
